# ==============================================================================
# Nexus AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your actual service credentials.
# DO NOT commit real secrets to source control.

# ------------------------------------------------------------------------------
# 1. Primary LLM Credentials (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini Model Identifier (e.g. gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Web Retrieval Credentials (Firecrawl)
# ------------------------------------------------------------------------------
# Obtain an API key from Firecrawl (https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------------------------
# 3. Observability & Tracing (Langfuse - Optional)
# ------------------------------------------------------------------------------
# Required only if distributed tracing and LLM metrics collection are enabled
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 4. Application Configuration
# ------------------------------------------------------------------------------
APP_NAME="Nexus AI Research Agent"
DEBUG=false
DATABASE_PATH=research_jobs.db
BACKEND_HOST=http://localhost:8000
